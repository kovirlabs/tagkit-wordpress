{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#2563eb" }
			]
		},
		"layout": {
			"contentSize": "min(44rem, 100%)",
			"wideSize": "min(1200px, 100%)"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Bricolage Grotesque",
					"fontFamily": "\"Bricolage Grotesque\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Bricolage Grotesque", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bricolage-grotesque/bricolage-grotesque-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Bricolage Grotesque", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/bricolage-grotesque/bricolage-grotesque-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				},
				{ "slug": "system", "name": "System", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" },
				{ "slug": "serif", "name": "Serif", "fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, serif" },
				{ "slug": "mono", "name": "Monospace", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem" }
			]
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "0px"
		},
		"blocks": {
			"core/buttons": { "spacing": { "blockGap": "0.5rem" } },
			"core/columns": { "spacing": { "blockGap": "1.5rem" } },
			"core/post-template": { "spacing": { "blockGap": "1.5rem" } },
			"core/navigation": { "spacing": { "blockGap": "1.5rem" } },
			"core/site-title": { "typography": { "fontFamily": "var:preset|font-family|heading" } }
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|heading" }
			},
			"button": {
				"border": { "radius": "var(--button-radius)" },
				"color": {
					"background": "var(--color-primary)",
					"text": "var(--color-on-primary, oklch(from var(--color-primary) clamp(0, (0.5636 - l) * 1000, 1) 0 0))"
				},
				"spacing": { "padding": "var(--button-padding)" },
				"typography": { "fontWeight": "var(--button-font-weight)", "fontFamily": "inherit", "fontSize": "inherit", "lineHeight": "inherit" },
				":hover": { "color": { "background": "var(--color-primary-hover, oklch(from var(--color-primary) calc(l + 0.08 * clamp(-1, (l - 0.5636) * 1000, 1)) c h))" } }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
